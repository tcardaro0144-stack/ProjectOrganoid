    "approve_write": { "change_id": "chg_...", "role": "user", "identity": "Tom" },
    "execute_write": { "change_id": "chg_..." }
  },
  "gated_writes": {
    "default": "read_only",
    "requires": ["change_id", "user_approval", "second_review_approval"],
    "allowlist": [
      "delete_actor",
      "set_component_property",
      "set_collision",
      "set_visibility",
      "set_transform",
      "compile_blueprint",
      "save_asset",
      "rerun_construction",
